# ---------------------------------------------------------------------------
# Canonical site URL — REQUIRED in production.
#
# Every canonical tag, sitemap entry, OpenGraph URL, robots.txt Host and
# JSON-LD @id is built from this. Get it wrong and the whole site tells Google
# it lives somewhere else.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so this must be present in
# the .env the server builds from (deploy.sh copies $HOME/.env into the
# checkout before `npm run build`). Setting it only at runtime does nothing.
#
# No trailing slash. Defaults to https://calibiupx.com when unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://calibiupx.com

# Search engine ownership verification. Paste the token only (not the whole
# meta tag). Leave blank until the property is claimed — an empty value is
# simply not rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Supabase — get these from your Supabase project: Settings → API
# Leave blank to run the app in fully local demo mode (localStorage + mock AI).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for live student writes/reads, atomic assessment commits, and full admin visibility.
# Server-side only; bypasses RLS only after the API verifies the student's access token.
# Settings → API → service_role key. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# REQUIRED (not an env var) — Supabase → Authentication → URL Configuration
#
# The app builds its OAuth `redirectTo` dynamically from window.location.origin
# (see app/login/page.tsx), so NOTHING in the code is hard-coded to a domain.
# Supabase, however, only honours a redirectTo that is on its allow list, and
# SILENTLY falls back to the Site URL when it is not — sign-in appears to work
# and then dumps the user on the wrong host. After the move to calibiupx.com
# this list MUST be updated or Google sign-in breaks on the new domain:
#
#   Site URL     : https://calibiupx.com                (production, canonical)
#   Redirect URLs: https://calibiupx.com/auth/callback
#                  https://www.calibiupx.com/auth/callback
#                  https://assessment.calibiai.com/auth/callback  (old host,
#                      keep while it still 301s, so in-flight links resolve)
#                  http://localhost:3000/auth/callback  (local dev)
#                  http://localhost:3002/auth/callback  (local dev, alt port)
#
# Google Cloud Console does NOT need changing per domain: Supabase is the OAuth
# client, so its Authorized redirect URI stays
# https://<project-ref>.supabase.co/auth/v1/callback for every deployment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI grader + in-exam assistant (server-side only, key is never sent to the
# browser). Powers /api/ai/evaluate, /api/ai/assistant and on-demand company
# assessment answer reviews at /api/company-assessments/evaluate.
#
# Leave the key blank to run on the built-in rule-based engine — the exam still
# works end to end, it just scores heuristically and the assistant answers from
# its local task knowledge base.
#
# DeepSeek is the default provider. Either variable set works; CALIBIAI_* wins
# when both are present, so an existing deployment keeps working unchanged:
#
#   DEEPSEEK_API_KEY   (or CALIBIAI_API_KEY)
#   DEEPSEEK_BASE_URL  (or CALIBIAI_BASE_URL)  default https://api.deepseek.com
#   DEEPSEEK_MODEL     (or CALIBIAI_MODEL)     default deepseek-chat
#
# Minimum working config for DeepSeek is just the key:
#   DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Legacy / override names (take precedence over the DEEPSEEK_* values above).
CALIBIAI_API_KEY=
CALIBIAI_BASE_URL=
CALIBIAI_MODEL=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) — OPTIONAL
# ---------------------------------------------------------------------------
# Signed admin-session cookie secret. Not required (a local fallback secret is
# used when blank) but you SHOULD set a long random value in production.
# Login credentials are fixed: username `admin`, password `CalibiAdmin@777`.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Company assessments — OPTIONAL
# ---------------------------------------------------------------------------
# Salts the per-student paper seed of the company mock assessments (falls back
# to ADMIN_SECRET, then a built-in constant). Set a long random value in
# production. Student requests are verified server-side; the server persists
# company attempts only when SUPABASE_SERVICE_ROLE_KEY is set. Students never
# write directly to Supabase.
COMPANY_PAPER_SECRET=

# Password given to the demo candidates that `npm run seed:supabase` (or the
# "Write candidates into Supabase" button on /admin) creates in Supabase Auth.
# Defaults to CalibiDemo@123 when blank.
SEED_PASSWORD=

# How often the admin dashboard checks for new student data, in milliseconds
# (default 30000). Each tick is a ~1KB change probe — the full dataset is only
# re-downloaded when something changed. Optional — set on the hosting platform,
# not in a checked-in file.
# NEXT_PUBLIC_ADMIN_REFRESH_MS=30000

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway — CalibiUpX Pro Subscriptions
# ---------------------------------------------------------------------------
# Key ID from Razorpay Dashboard (Settings → API Keys).
# Safe to expose publicly on client: NEXT_PUBLIC_RAZORPAY_KEY_ID or RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Key Secret from Razorpay Dashboard (Server-only, NEVER expose client-side)
RAZORPAY_KEY_SECRET=

